# TwitchBot account secrets (.env in project root, gitignored).
# Generate fresh tokens by running: python scripts/get_all_scopes.py
# See the docs for the cloudflared install requirement (winget install cloudflare.cloudflared).
#
# OAuth redirect URI requirement:
#   The get_all_scopes.py flow redirects the browser to
#   http://localhost:5003/oauth/callback
#   This URL MUST be registered exactly (scheme, host, port, path) in the
#   Twitch Developer Console under your app -> OAuth Redirect URLs, or
#   Twitch rejects the authorization with "redirect_uri_mismatch".
#   Register it once per app; see README.md "Twitch app registration & OAuth setup".

# --- Bot account (does all sending + receives chat) ---
BOT_USERNAME=yourbotaccount
BOT_CLIENT_ID=yourtwitchappclientid
BOT_CLIENT_SECRET=yourtwitchappclientsecret
BOT_OAUTH_TOKEN=
BOT_REFRESH_TOKEN=
BOT_CHANNEL_ID=                 # numeric Twitch user id of the bot account (filled by validate)
BOT_SCOPES=user:read:chat user:bot user:write:chat moderator:read:followers moderator:manage:banned_users moderator:manage:chat_messages clips:edit

# --- Channel / broadcaster account (read-only grants) ---
TWITCH_CHANNEL=streamerlogin
TWITCH_CHANNEL_ID=              # numeric broadcaster id (primary source; filled by channel token validate)
# CHANNEL_CLIENT_ID defaults to BOT_CLIENT_ID when left empty; only set if the
# channel uses a separate Twitch app registration.
CHANNEL_CLIENT_ID=
CHANNEL_OAUTH_TOKEN=
CHANNEL_REFRESH_TOKEN=
CHANNEL_SCOPES=channel:bot channel:read:subscriptions channel:read:redemptions bits:read
